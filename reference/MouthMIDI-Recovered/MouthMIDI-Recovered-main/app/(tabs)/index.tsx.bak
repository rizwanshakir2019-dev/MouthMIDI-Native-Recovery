  meterOuter: { position: 'absolute', left: 12, width: 14, borderRadius: 7, backgroundColor: 'rgba(255,255,255,0.05)', borderWidth: 1, borderColor: 'rgba(255,255,255,0.09)', overflow: 'visible' },
